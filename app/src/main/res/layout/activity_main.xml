<?xml version="1.0" encoding="utf-8"?>
<!--
  The two swipeable screens sit in the pager; Effects is not a third page but a
  full-screen overlay above it, reachable from either one and dismissed with
  back. Keeping it out of the pager is what lets the playlist keep its bottom
  bar and mini player while the effects screen owns the whole window.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
