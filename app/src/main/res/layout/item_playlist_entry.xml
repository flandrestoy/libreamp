<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_playlist_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/row_padding_start"
    android:paddingTop="7dp"
    android:paddingEnd="@dimen/gutter_list"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/text_track_number"
        style="@style/Text.Mono.RowNumber"
        android:layout_width="@dimen/row_number_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="@color/row_number_tint"
        tools:text="04" />

    <CheckBox
        android:id="@+id/checkbox_select"
        android:layout_width="@dimen/checkbox_size"
        android:layout_height="@dimen/checkbox_size"
        android:layout_marginEnd="10dp"
        android:background="@null"
        android:button="@drawable/checkbox_square"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/image_art"
        android:layout_width="@dimen/row_art"
        android:layout_height="@dimen/row_art"
        android:contentDescription="@null"
        android:foreground="@drawable/bg_art_frame"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_title"
            style="@style/Text.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/row_title_tint"
            tools:text="Nightbus to Ōmiya" />

        <TextView
            android:id="@+id/text_subtitle"
            style="@style/Text.RowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            tools:text="Kōji Nagata · Slow Light" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_duration"
        style="@style/Text.Mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_tertiary"
        tools:text="5:21" />

    <ImageView
        android:id="@+id/drag_handle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/action_reorder"
        android:src="@drawable/ic_drag_handle"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
