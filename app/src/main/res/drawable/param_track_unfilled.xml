<?xml version="1.0" encoding="utf-8"?>
<!--
  Balance runs from a centre detent, so a fill growing from the left edge would
  be a lie about where "no effect" is. The rail stays empty and the thumb alone
  carries the value; the centre tick behind it is drawn by the layout.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_control" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
            </shape>
        </clip>
    </item>
</layer-list>
