<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately taller than the track, so it reads as a fader cap on a rail. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="@dimen/seek_thumb_width"
        android:height="@dimen/seek_thumb_height" />
    <solid android:color="@color/accent_edge" />
    <stroke android:width="1dp" android:color="@color/accent_edge_dark" />
</shape>
