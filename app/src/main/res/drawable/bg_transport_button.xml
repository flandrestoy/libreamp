<?xml version="1.0" encoding="utf-8"?>
<!-- Shuffle/repeat light up by swapping to the accent wash; prev/next stay neutral. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_wash" />
                    <stroke android:width="1dp" android:color="@color/accent_wash_border" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_panel" />
                    <stroke android:width="1dp" android:color="@color/border" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
