<?xml version="1.0" encoding="utf-8"?>
<!-- The explicit size is what SwitchCompat measures thumb travel against. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size
                android:width="@dimen/switch_width"
                android:height="@dimen/switch_height" />
            <solid android:color="@color/accent_track_on" />
            <stroke android:width="1dp" android:color="@color/border_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="@dimen/switch_width"
                android:height="@dimen/switch_height" />
            <solid android:color="@color/surface_control" />
            <stroke android:width="1dp" android:color="@color/border_control" />
        </shape>
    </item>
</selector>
