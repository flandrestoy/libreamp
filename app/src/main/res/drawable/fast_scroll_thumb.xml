<?xml version="1.0" encoding="utf-8"?>
<!--
  RecyclerView's built-in fast scroller requires the thumb to be a StateListDrawable
  (it casts it), hence the selector even though only the pressed state differs.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="#D0BCFF" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="#996750A4" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</selector>
